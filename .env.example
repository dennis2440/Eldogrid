# --- App ---
APP_ENV=development
DEMO_MODE=true                # true = use canned responses for all external calls
DATABASE_URL=sqlite:///./eldogrid.db
PUBLIC_BASE_URL=http://localhost:8000   # public https URL once deployed/tunneled

# --- Africa's Talking (sandbox) ---
AT_USERNAME=sandbox
AT_API_KEY=your_sandbox_api_key_here
AT_SENDER_ID=

# --- Roboflow ---
ROBOFLOW_API_KEY=your_roboflow_key_here
ROBOFLOW_MODEL_ID=your-project/1

# --- Weather ---
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
ELDORET_LAT=0.5143
ELDORET_LON=35.2698

# --- Demo / mock payments ---
MOCK_MPESA_AUTO_CONFIRM_SECONDS=5
ALERT_RAIN_THRESHOLD_MM=50
